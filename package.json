{
  "name": "@lumine-code/tree-sitter-swift",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Parses Swift source code with Tree-sitter.",
  "main": "bindings/node/index.js",
  "types": "bindings/node",
  "scripts": {
    "install": "tree-sitter generate && node-gyp-build",
    "test": "tree-sitter test && node --test test/wasm.test.cjs",
    "lint": "eslint test/wasm.test.cjs eslint.config.cjs && prettier --check package.json tree-sitter.json README.md eslint.config.cjs .prettierrc.json .github/workflows/ci.yml .github/workflows/publish.yml test/wasm.test.cjs",
    "build": "tree-sitter generate",
    "prepare": "tree-sitter generate"
  },
  "repository": "https://github.com/lumine-code/tree-sitter-swift",
  "tree-sitter": [
    {
      "scope": "source.swift",
      "file-types": [
        "swift"
      ],
      "injection-regex": "swift",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "keywords": [
    "swift",
    "tree-sitter",
    "parser",
    "webassembly",
    "lumine"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "scripts/*",
    "src/**",
    "*.wasm",
    "test/wasm.test.cjs",
    "test/scanner-allocation.c"
  ],
  "license": "MIT",
  "bugs": "https://github.com/lumine-code/tree-sitter-swift/issues",
  "homepage": "https://github.com/lumine-code/tree-sitter-swift",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.0",
    "tree-sitter-cli": "0.27.0",
    "which": "2.0.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "web-tree-sitter": "0.27.0",
    "globals": "^17.12.0",
    "@eslint/js": "^10.0.1",
    "node-gyp": "13.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
